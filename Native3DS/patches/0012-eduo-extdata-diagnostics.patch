+// eDuo diagnostics: ExtSaveData open/format outcomes at Info level, rate limited (a game that
+// keeps its settings in extdata, e.g. a per-unit BGM choice, can be traced from core_log).
+static void EduoExtLog(const char* what, const std::string& path, bool ok) {
+    static std::atomic<int> count{0};
+    if (count.fetch_add(1) < 60) {
+        LOG_INFO(Service_FS, "eDuo extdata {}: {} ({})", what, path, ok ? "ok" : "FAILED");
+    }
+}
