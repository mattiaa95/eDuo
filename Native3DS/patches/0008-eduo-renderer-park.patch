+    /// eDuo (iOS): drains every piece of GPU work still in flight (queued command chunks, frames
+    /// waiting for the present thread) and waits for the device to go idle. Called on the core
+    /// thread right before it parks, because iOS kills an app that submits Metal work from the
+    /// background. No-op by default.
+    virtual void Park() {}
+
     /// This is called to notify the rendering backend of a surface change
     // if second == true then it is the second screen
     virtual void NotifySurfaceChanged(bool second) {}
