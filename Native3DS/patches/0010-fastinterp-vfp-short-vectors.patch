+// VFPv2 short-vector mode. When FPSCR.LEN != 0 and the destination register is
+// outside the scalar bank, data-processing instructions run LEN+1 times over
+// circular register banks (8 singles / 4 doubles), stepping by FPSCR.STRIDE; a
+// second operand in the scalar bank stays fixed. Same rules as Dynarmic's
+// EmitVfpVectorOperation. BODY sees the register indices as d, n and m.
+#define VFP_VEC_OP(BANK, SCALAR_MASK, BODY) do { \
+    u32 d = inst->vfp.sd, n = inst->vfp.sn, m = inst->vfp.sm; \
+    (void)n; \
+    if (__builtin_expect((state_.fpscr & 0x00070000) == 0 || (d & (SCALAR_MASK)) == 0, 1)) { \
+        BODY; \
+    } else { \
+        const u32 vfp_vec_len_ = ((state_.fpscr >> 16) & 7) + 1; \
+        const u32 vfp_vec_stride_ = ((state_.fpscr >> 20) & 3) == 3 ? 2 : 1; \
+        const bool vfp_m_scalar_ = (m & (SCALAR_MASK)) == 0; \
+        for (u32 vfp_vec_i_ = 0; vfp_vec_i_ < vfp_vec_len_; ++vfp_vec_i_) { \
+            BODY; \
+            d = (d & ~((BANK) - 1)) | ((d + vfp_vec_stride_) & ((BANK) - 1)); \
+            n = (n & ~((BANK) - 1)) | ((n + vfp_vec_stride_) & ((BANK) - 1)); \
+            if (!vfp_m_scalar_) \
+                m = (m & ~((BANK) - 1)) | ((m + vfp_vec_stride_) & ((BANK) - 1)); \
+        } \
+    } \
+} while (0)
+#define VFP_VEC_S(BODY) VFP_VEC_OP(8u, 0x18u, BODY)
+#define VFP_VEC_D(BODY) VFP_VEC_OP(4u, 0x0Cu, BODY)
+
