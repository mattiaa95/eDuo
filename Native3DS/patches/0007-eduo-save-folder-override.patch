+// eDuo: prefix aliases (from -> to), see SetSerializedPathAlias.
+namespace {
+std::mutex g_alias_mutex;
+std::vector<std::pair<std::string, std::string>> g_aliases;
+} // namespace
+
+void SetSerializedPathAlias(const std::string& from, const std::string& to) {
+    if (from.empty()) {
+        return;
+    }
+    std::lock_guard lock(g_alias_mutex);
+    std::erase_if(g_aliases, [&](const auto& alias) { return alias.first == from; });
+    if (!to.empty()) {
+        g_aliases.emplace_back(from, to);
+    }
+}
+
 std::string SerializePath(const std::string& input, bool is_saving) {
     auto result = input;
+    std::vector<std::pair<std::string, std::string>> aliases;
+    {
+        std::lock_guard lock(g_alias_mutex);
+        aliases = g_aliases;
+    }
+    // eDuo: saving, the real folder goes back to the stock one before the placeholders are
+    // swapped in (leading prefix only).
+    if (is_saving) {
+        for (const auto& [from, to] : aliases) {
+            if (result.compare(0, to.size(), to) == 0) {
+                result = from + result.substr(to.size());
+                break;
+            }
+        }
+    }
     StringReplace(result, "%CITRA_ROM_FILE%", g_currentRomPath, is_saving);
     StringReplace(result, "%CITRA_USER_DIR%", GetUserPath(UserPath::UserDir), is_saving);
     StringReplace(result, "%CITRA_USER_SDMC%", GetUserPath(UserPath::SDMCDir), is_saving);
     StringReplace(result, "%CITRA_USER_NAND%", GetUserPath(UserPath::NANDDir), is_saving);
+    // eDuo: loading, the stock folder a state recorded maps to the real one.
+    if (!is_saving) {
+        for (const auto& [from, to] : aliases) {
+            if (result.compare(0, from.size(), from) == 0) {
+                result = to + result.substr(from.size());
+                break;
+            }
+        }
+    }
     return result;
 }
 
