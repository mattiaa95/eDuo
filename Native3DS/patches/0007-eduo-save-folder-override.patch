+// eDuo: per-title save folder chosen by the app (program ID -> folder with a trailing '/').
+std::mutex g_override_mutex;
+std::unordered_map<u64, std::string> g_overrides;
+
+std::string GetOverride(u64 program_id) {
+    std::lock_guard lock(g_override_mutex);
+    const auto it = g_overrides.find(program_id);
+    return it == g_overrides.end() ? std::string() : it->second;
+}
+
 std::string GetSaveDataPath(const std::string& mount_location, u64 program_id) {
+    if (const std::string folder = GetOverride(program_id); !folder.empty()) {
+        return folder + "00000001/"; // eDuo
+    }
     u32 high = static_cast<u32>(program_id >> 32);
     u32 low = static_cast<u32>(program_id & 0xFFFFFFFF);
     return fmt::format("{}{:08x}/{:08x}/data/00000001/", mount_location, high, low);
 }
 
 std::string GetSaveDataMetadataPath(const std::string& mount_location, u64 program_id) {
+    if (const std::string folder = GetOverride(program_id); !folder.empty()) {
+        return folder + "00000001.metadata"; // eDuo
+    }
     u32 high = static_cast<u32>(program_id >> 32);
     u32 low = static_cast<u32>(program_id & 0xFFFFFFFF);
     return fmt::format("{}{:08x}/{:08x}/data/00000001.metadata", mount_location, high, low);
 }
 
+// eDuo: the stock `data/` folder of a title (save states record paths under it).
+std::string GetStockDataDir(const std::string& sdmc_directory, u64 program_id) {
+    u32 high = static_cast<u32>(program_id >> 32);
+    u32 low = static_cast<u32>(program_id & 0xFFFFFFFF);
+    return fmt::format("{}{:08x}/{:08x}/data/", GetSaveDataContainerPath(sdmc_directory), high,
+                       low);
+}
+
 } // namespace
 
 ArchiveSource_SDSaveData::ArchiveSource_SDSaveData(const std::string& sdmc_directory)
@@ -143,4 +169,32 @@ std::string ArchiveSource_SDSaveData::GetSaveDataPathFor(const std::string& moun
     return GetSaveDataPath(GetSaveDataContainerPath(mount_point), program_id);
 }
 
+// eDuo
+std::string ArchiveSource_SDSaveData::GetStockSaveDataPathFor(const std::string& sdmc_directory,
+                                                              u64 program_id) {
+    return GetStockDataDir(sdmc_directory, program_id) + "00000001/";
+}
+
+// eDuo
+void ArchiveSource_SDSaveData::SetSaveDataFolderOverride(u64 program_id,
+                                                         const std::string& folder) {
+    std::string normalized = folder;
+    if (!normalized.empty() && normalized.back() != '/') {
+        normalized += '/';
+    }
+    {
+        std::lock_guard lock(g_override_mutex);
+        if (normalized.empty()) {
+            g_overrides.erase(program_id);
+        } else {
+            g_overrides[program_id] = normalized;
+        }
+    }
+    // Save states keep recording the stock path (portable through %CITRA_USER_SDMC%) and map it
+    // back to the override folder when loaded.
+    FileUtil::SetSerializedPathAlias(
+        GetStockDataDir(FileUtil::GetUserPath(FileUtil::UserPath::SDMCDir), program_id),
+        normalized);
+}
+
 } // namespace FileSys
