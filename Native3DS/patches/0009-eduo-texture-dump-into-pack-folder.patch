 namespace VideoCore {
 
+// eDuo: dumps and packs share one folder (load/textures/<ID>/). A dump is stamped with a
+// modification time of kUntouchedBase + its size in bytes, so the loader can tell the files it
+// wrote itself and that nobody has touched (loading them would only decode thousands of
+// identical PNGs into RAM) from the ones the player edited or added: any editor writes a new
+// modification time, so those load as replacements.
+static constexpr long long kUntouchedBase = 946684800; // 2000-01-01 UTC
+
+bool IsUntouchedDump(const std::string& path) {
+    struct stat st {};
+    return stat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode) &&
+           static_cast<long long>(st.st_mtime) == kUntouchedBase + static_cast<long long>(st.st_size);
+}
+
+bool MarkUntouchedDump(const std::string& path) {
+    struct stat st {};
+    if (stat(path.c_str(), &st) != 0) {
+        return false;
+    }
+    const struct timeval times[2] = {{static_cast<time_t>(kUntouchedBase + st.st_size), 0},
+                                     {static_cast<time_t>(kUntouchedBase + st.st_size), 0}};
+    return utimes(path.c_str(), times) == 0;
+}
+
