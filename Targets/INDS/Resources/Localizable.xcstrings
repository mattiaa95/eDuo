    "Fills the space around and between the two screens while playing. Applies the next time you open a game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt während des Spielens den Bereich um und zwischen den beiden Bildschirmen aus. Wird beim nächsten Öffnen eines Spiels angewendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocupa el espacio que hay alrededor y entre las dos pantallas mientras se juega. Se aplica la próxima vez que abras un juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplit l'espace autour et entre les deux écrans pendant le jeu. S'applique dès la prochaine ouverture d'un jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riempie lo spazio attorno e tra i due schermi durante il gioco. Si applica alla successiva apertura di un gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイ中に、2つの画面の周囲や間のスペースを埋めます。次回ゲームを起動した際に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 플레이 중 두 화면 주변과 사이의 공간을 채워줍니다. 다음에 게임을 실행할 때 적용됩니다."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preenche o espaço à volta e entre os dois ecrãs durante o jogo. Aplica-se na próxima vez que abrires um jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время игры заполняет пространство вокруг и между двумя экранами. Применяется при следующем запуске игры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在游戏过程中，会填充两块屏幕周围及之间的空白区域。下次打开游戏时生效。"
          }
        }
      }
    },
