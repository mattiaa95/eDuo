    "Built with care by an independent developer.\nYour support keeps eDuo moving forward." : {
      "comment" : "Paywall personal message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Sorgfalt von einem unabhängigen Entwickler gebaut.\nDeine Unterstützung bringt eDuo voran."
