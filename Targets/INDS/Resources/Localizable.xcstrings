    "Thank you for your support!\nEnjoy the full experience." : {
      "comment" : "Purchase success message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielen Dank für deine Unterstützung!\nGenieße das Erlebnis in vollen Zügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Gracias por tu apoyo!\nDisfruta de la experiencia al máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci pour votre soutien !\nProfitez pleinement de cette expérience."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie per il tuo supporto!\nGoditi l'esperienza completa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご支援ありがとうございます！\nぜひ存分にお楽しみください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응원해 주셔서 감사합니다!\n이 경험을 마음껏 즐기세요."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado pelo seu apoio!\nAproveite a experiência completa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо за вашу поддержку!\nНаслаждайтесь всеми возможностями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢您的支持！\n尽情享受完整的体验吧。"
