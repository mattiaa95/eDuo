          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "eDuoが検出した内容"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "eDuo가 감지한 항목"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
