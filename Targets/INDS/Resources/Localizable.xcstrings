    "Go PRO to use your own photos behind the screens, with a separate background for portrait and landscape." : {
      "comment" : "Background skin gate message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol dir PRO, um eigene Fotos hinter die Bildschirme zu legen – mit getrennten Hintergründen für Hoch- und Querformat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazte PRO para poner tus propias fotos detrás de las pantallas, con un fondo distinto para vertical y horizontal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez à PRO pour placer vos propres photos derrière les écrans, avec un arrière-plan distinct en portrait et en paysage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a PRO per mettere le tue foto dietro agli schermi, con uno sfondo separato per verticale e orizzontale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PROにアップグレードすると、画面の後ろに好きな写真を設定できます。縦向きと横向きで別々の背景を使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PRO로 업그레이드하면 화면 뒤에 원하는 사진을 넣을 수 있습니다. 세로와 가로에 각각 다른 배경을 사용할 수 있습니다."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adquira o PRO para colocar as suas próprias fotografias por trás dos ecrãs, com um fundo diferente para vertical e horizontal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оформите PRO, чтобы поставить свои фотографии за экранами — с отдельным фоном для вертикальной и горизонтальной ориентации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升级到 PRO 即可将自己的照片放在屏幕后方，竖屏和横屏可分别设置背景。"
          }
        }
      }
    },
